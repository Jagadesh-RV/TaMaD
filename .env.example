# =============================================================================
# TaMaD Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
#
# Required variables will cause the application to refuse startup if missing.
# =============================================================================

# --- Server Configuration ---
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# --- MongoDB ---
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=TaMaD

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- JWT Secrets (change for production) ---
JWT_SECRET=<your-jwt-secret-min-32-chars>
JWT_REFRESH_SECRET=<your-jwt-refresh-secret-min-32-chars>
JWT_EXPIRES_IN=15m

# --- Firebase Admin ---
FIREBASE_PROJECT_ID=<your-firebase-project-id>
FIREBASE_CLIENT_EMAIL=<your-firebase-client-email>
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n<your-private-key>\n-----END PRIVATE KEY-----\n"

# --- AI / Gemini ---
GEMINI_API_KEY=<your-gemini-api-key>

# --- SMTP / Email ---
SMTP_HOST=<smtp-host>
SMTP_PORT=587
SMTP_USER=<smtp-username>
SMTP_PASS=<smtp-password>
SMTP_FROM=noreply@tamad.app

# --- Monitoring ---
SENTRY_DSN=<your-sentry-dsn>
