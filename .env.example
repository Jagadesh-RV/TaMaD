# CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Frontend URL (for Socket.IO CORS)
FRONTEND_URL=http://localhost:5173

# LiveKit
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Gemini
GEMINI_API_KEY=

# Automation
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=ss://your-livekit-instance.livekit.cloud
