# ==========================================
# TaMaD Backend Environment Configuration
# ==========================================
# Copy this file to .env and fill in the values.

# Firebase Admin SDK
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# JWT Secrets (generate with: openssl rand -base64 32)
JWT_SECRET=your_jwt_secret_change_this
JWT_REFRESH_SECRET=your_refresh_secret_change_this

# Database
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/tamad?retryWrites=true&w=majority

# Redis (optional, for caching/sessions)
REDIS_URL=redis://localhost:6379

# Server
PORT=5000
NODE_ENV=production

# CORS
CORS_ORIGIN=https://your-domain.com,https://www.your-domain.com

# Frontend URL (for email links, redirects)
FRONTEND_URL=https://your-domain.com

# AI Integration (optional)
GEMINI_API_KEY=your_gemini_api_key_here
