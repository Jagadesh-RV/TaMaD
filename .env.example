# ==========================================
# TaMaD Production Environment Configuration
# ==========================================

# Database
# The MongoDB connection string (e.g., MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/tamad?retryWrites=true&w=majority

# Authentication
# A strong, randomly generated secret string for signing JWT tokens.
# Use `openssl rand -base64 32` to generate one.
JWT_SECRET=your_super_secret_jwt_string_change_in_production
JWT_REFRESH_SECRET=your_super_secret_refresh_string_change_in_production
FRONTEND_URL=http://localhost

# Firebase Admin SDK
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Server Configuration
# The port the Node.js backend should listen on
PORT=5000
NODE_ENV=production

# AI Integration
# Get an API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
