rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidImage() {
      return request.resource.contentType.matches('image/.*')
        && request.resource.size < 5 * 1024 * 1024; // 5MB
    }

    function isValidFile() {
      return request.resource.size < 50 * 1024 * 1024; // 50MB
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function isPdf() {
      return request.resource.contentType == 'application/pdf';
    }

    function isDocument() {
      return request.resource.contentType.matches('image/.*')
        || request.resource.contentType == 'application/pdf'
        || request.resource.contentType.matches('text/.*')
        || request.resource.contentType.matches('application/msword')
        || request.resource.contentType.matches('application/vnd.openxmlformats.*');
    }

    // New uploads must be bound to the authenticated uploader via custom
    // metadata. Mutations (overwrite/delete) are restricted to that uploader;
    // legacy objects without the uid metadata remain deletable by any
    // authenticated user so pre-existing files are not orphaned.
    function isOwnedUpload() {
      return isAuthenticated()
        && request.resource.metadata.uid == request.auth.uid;
    }

    function canMutate() {
      return isAuthenticated()
        && (resource.metadata.uid == request.auth.uid
          || !resource.metadata.keys().hasAny(['uid']));
    }

    // User profile images
    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner(userId) && isValidImage();
      allow delete: if isOwner(userId);
    }

    // Workspace files
    match /workspaces/{workspaceId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isOwnedUpload() && isValidFile();
      allow delete: if canMutate();
    }

    // Task attachments
    match /workspaces/{workspaceId}/tasks/{taskId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isOwnedUpload() && isValidFile();
      allow delete: if canMutate();
    }

    // Project files
    match /workspaces/{workspaceId}/projects/{projectId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isOwnedUpload() && isValidFile();
      allow delete: if canMutate();
    }

    // Notes attachments
    match /workspaces/{workspaceId}/notes/{noteId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isOwnedUpload() && isValidFile();
      allow delete: if canMutate();
    }

    // Whiteboard images
    match /workspaces/{workspaceId}/whiteboards/{whiteboardId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isOwnedUpload() && isImage() && request.resource.size < 10 * 1024 * 1024; // 10MB
      allow delete: if canMutate();
    }

    // Default deny everything else
    match /{allPaths=**} {
      allow read: if false;
      allow write: if false;
      allow delete: if false;
    }
  }
}
