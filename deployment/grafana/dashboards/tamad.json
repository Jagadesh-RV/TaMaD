{
  "title": "TaMaD Platform Overview",
  "version": 1,
  "panels": [
    {
      "title": "API Health",
      "type": "stat",
      "targets": [{ "expr": "up{job='tamad-backend'}" }]
    },
    {
      "title": "Request Rate",
      "type": "graph",
      "targets": [{ "expr": "rate(http_requests_total[5m])" }]
    },
    {
      "title": "Error Rate",
      "type": "graph",
      "targets": [{ "expr": "rate(http_requests_total{status=~'5..'}[5m])" }]
    },
    {
      "title": "Active Queue Jobs",
      "type": "stat",
      "targets": [{ "expr": "bullmq_active_jobs_total" }]
    }
  ]
}
